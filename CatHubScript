	KeyESP = false,
	ItemESP = false,
	NotifyItems = false,
	InfiniteItems = false,
	AutoHotel = false,
	LeverESP = false,
	ClosetESP = false
}

pcall(function()
	if readfile and isfile and isfile(autoSaveFileName) then
		local success, decoded = pcall(function()
			return HttpService:JSONDecode(readfile(autoSaveFileName))
		end)
		if success and decoded and type(decoded) == "table" then
			for k, v in pairs(decoded) do
				_G.CatHubSettings[k] = v
			end
		end
	end
end)

local function SaveAutoSettings()
	pcall(function()
		if writefile then
			writefile(autoSaveFileName, HttpService:JSONEncode(_G.CatHubSettings))
		end
	end)
end

