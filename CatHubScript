	Label.TextColor3 = Color3.fromRGB(185, 185, 200)
	Label.Font = Enum.Font.Code
	Label.TextSize = 11
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = ToggleFrame

	local Switch = Instance.new("TextButton")
	Switch.Size = UDim2.new(0, 36, 0, 18)
	Switch.Position = UDim2.new(1, -36, 0.5, -9)
	Switch.BackgroundColor3 = Color3.fromRGB(32, 32, 45)
	Switch.Text = ""
	Switch.Parent = ToggleFrame

	local SwitchCorner = Instance.new("UICorner")
	SwitchCorner.CornerRadius = UDim.new(1, 0)
	SwitchCorner.Parent = Switch

	local Circle = Instance.new("Frame")
	Circle.Size = UDim2.new(0, 14, 0, 14)
	Circle.Position = UDim2.new(0, 2, 0.5, -7)
	Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	Circle.Parent = Switch

	local CircleCorner = Instance.new("UICorner")
	CircleCorner.CornerRadius = UDim.new(1, 0)
	CircleCorner.Parent = Circle

	local initialState = CatHubSettings[settingKey] or false
	if initialState then
		Switch.BackgroundColor3 = Color3.fromRGB(130, 85, 245)
		Circle.Position = UDim2.new(1, -16, 0.5, -7)
	end

	Switch.MouseButton1Click:Connect(function()
		local newState = not CatHubSettings[settingKey]
		CatHubSettings[settingKey] = newState
		SaveAutoSettings()

		if newState then
			Switch.BackgroundColor3 = Color3.fromRGB(130, 85, 245)
			Circle:TweenPosition(UDim2.new(1, -16, 0.5, -7), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
		else
			Switch.BackgroundColor3 = Color3.fromRGB(32, 32, 45)
			Circle:TweenPosition(UDim2.new(0, 2, 0.5, -7), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
		end
		if callback then callback(newState) end
	end)
end

-- Função Slider
local function AddSlider(section, text, min, max, default, settingKey, callback)
	local actualDefault = CatHubSettings[settingKey] or default
	CatHubSettings[settingKey] = actualDefault

	local SliderFrame = Instance.new("Frame")
	SliderFrame.Size = UDim2.new(1, 0, 0, 40)
	SliderFrame.BackgroundTransparency = 1
	SliderFrame.Parent = section

	local TitleLabel = Instance.new("TextLabel")
	TitleLabel.Size = UDim2.new(1, 0, 0, 16)
	TitleLabel.BackgroundTransparency = 1
	TitleLabel.Text = text .. ": " .. tostring(actualDefault)
	TitleLabel.TextColor3 = Color3.fromRGB(185, 185, 200)
	TitleLabel.Font = Enum.Font.Code
	TitleLabel.TextSize = 11
	TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
	TitleLabel.Parent = SliderFrame

	local BarBg = Instance.new("Frame")
	BarBg.Size = UDim2.new(1, 0, 0, 8)
	BarBg.Position = UDim2.new(0, 0, 0, 24)
	BarBg.BackgroundColor3 = Color3.fromRGB(32, 32, 45)
	BarBg.BorderSizePixel = 0
	BarBg.Parent = SliderFrame

	local BarBgCorner = Instance.new("UICorner")
	BarBgCorner.CornerRadius = UDim.new(1, 0)
	BarBgCorner.Parent = BarBg

	local BarFill = Instance.new("Frame")
	BarFill.Size = UDim2.new((actualDefault - min) / (max - min), 0, 1, 0)
	BarFill.BackgroundColor3 = Color3.fromRGB(130, 85, 245)
	BarFill.BorderSizePixel = 0
	BarFill.Parent = BarBg

	local BarFillCorner = Instance.new("UICorner")
	BarFillCorner.CornerRadius = UDim.new(1, 0)
	BarFillCorner.Parent = BarFill

	local dragging = false
	local function updateValue(input)
		local pos = math.clamp((input.Position.X - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X, 0, 1)
		local value = math.floor(min + ((max - min) * pos))
		BarFill.Size = UDim2.new(pos, 0, 1, 0)
		TitleLabel.Text = text .. ": " .. tostring(value)
		CatHubSettings[settingKey] = value
		SaveAutoSettings()
		if callback then callback(value) end
	end

	BarBg.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateValue(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateValue(input)
		end
	end)
end

