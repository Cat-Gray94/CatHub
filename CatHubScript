local isOpen = false

local function ToggleGuiAnimation()
	isOpen = not isOpen
	if isOpen then
		MainFrame.Visible = true
		MainFrame.Size = UDim2.new(0, 0, 0, 0)
		MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)

		-- Na função de animação de abertura (ToggleGuiAnimation):
		MainFrame:TweenSizeAndPosition(
    		UDim2.new(0, 480, 0, 280), -- Atualizado para o novo tamanho compacto
    		UDim2.new(0.5, 0, 0.5, 0), 
    		Enum.EasingDirection.Out, 
    		Enum.EasingStyle.Back, 
    		0.35, 
    		true
		)
	else
		MainFrame:TweenSizeAndPosition(
			UDim2.new(0, 0, 0, 0), 
			UDim2.new(0.5, 0, 0.5, 0), 
			Enum.EasingDirection.In, 
			Enum.EasingStyle.Quad, 
			0.25, 
			true, 
			function()
				if not isOpen then
					MainFrame.Visible = false
				end
			end
		)
	end
end

ToggleButton.MouseButton1Click:Connect(ToggleGuiAnimation)

MinimizeBtn.MouseButton1Click:Connect(function()
	if isOpen then ToggleGuiAnimation() end
end)


