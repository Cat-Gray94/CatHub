-- Função de Filtragem da SearchBox
SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
	local query = SearchBox.Text:lower()
	if not tabs then return end

	for _, tabData in ipairs(tabs) do
		local page = tabData.Page
		for _, section in ipairs(page:GetChildren()) do
			if section:IsA("Frame") then
				local container = section:FindFirstChildOfClass("ScrollingFrame")
				if container then
					for _, item in ipairs(container:GetChildren()) do
						if item:IsA("Frame") then
							local label = item:FindFirstChildOfClass("TextLabel")
							if label then
								local featureName = label.Text:lower()
								if query == "" or featureName:find(query) then
									item.Visible = true
								else
									item.Visible = false
								end
							end
						end
					end
				end
			end
		end
	end
end)

