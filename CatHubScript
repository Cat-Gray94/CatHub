-- ==================== AUTO HOTEL (PATHFIND NODES) ====================
task.spawn(function()
	local processedRooms = {}

	while task.wait(0.1) do
		local settings = _G.CatHubSettings or CatHubSettings
		if settings and settings.AutoHotel then
			pcall(function()
				local char = LocalPlayer.Character
				local rootPart = char and char:FindFirstChild("HumanoidRootPart")
				local humanoid = char and char:FindFirstChildOfClass("Humanoid")
				local currentRooms = workspace:FindFirstChild("CurrentRooms")
				local latestRoomNum = workspace:GetAttribute("LatestRoom")

				if rootPart and humanoid and currentRooms and latestRoomNum then
					local roomFolder = currentRooms:FindFirstChild(tostring(latestRoomNum))

					if roomFolder and not processedRooms[roomFolder] then
						local nodesFolder = roomFolder:FindFirstChild("PathfindNodes")

						if nodesFolder then
							-- Coleta e ordena os nós numericamente (1, 2, 3...)
							local nodes = {}
							for _, node in ipairs(nodesFolder:GetChildren()) do
								local num = tonumber(node.Name)
								if num then
									table.insert(nodes, {Index = num, Part = node})
								end
							end

							table.sort(nodes, function(a, b)
								return a.Index < b.Index
							end)

							-- Move o player por cada nó em ordem rigorosa
							for _, nodeData in ipairs(nodes) do
								if not settings.AutoHotel then break end
								local targetPos = nodeData.Part.Position
								humanoid:MoveTo(targetPos)

								-- Aguarda o player chegar perto do nó atual antes de ir pro próximo
								local startTime = tick()
								repeat
									task.wait(0.05)
								until not settings.AutoHotel or (rootPart.Position - targetPos).Magnitude < 4 or (tick() - startTime) > 2.5
							end
						end

						-- Ao terminar os nós, vai até a porta da sala
						local door = roomFolder:FindFirstChild("Door")
						local doorPart = door and (door:FindFirstChild("MeshPart") or door:FindFirstChild("Door") or door:FindFirstChild("Base"))
						if doorPart then
							humanoid:MoveTo(doorPart.Position)
							repeat
								task.wait(0.05)
							until not settings.AutoHotel or (rootPart.Position - doorPart.Position).Magnitude < 5
						end

						-- Salva a sala como processada para evitar loop e limpa referências antigas para poupar memória
						processedRooms[roomFolder] = true

						-- Limpeza preventiva de salas muito antigas da tabela para evitar lag/memory leak
						for oldRoom, _ in pairs(processedRooms) do
							if oldRoom and oldRoom.Parent ~= currentRooms then
								processedRooms[oldRoom] = nil
							end
						end
					end
				end
			end)
		end
	end
end)

