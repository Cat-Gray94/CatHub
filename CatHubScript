local connectedTools = {}
task.spawn(function()
    while task.wait(0.5) do
        local settings = _G.CatHubSettings or CatHubSettings
        if settings and settings.InfiniteItems then
            pcall(function()
                local char = LocalPlayer.Character
                local tool = char and char:FindFirstChildOfClass("Tool")
                if tool then
                    local name = tool.Name
                    if (name == "Lockpick" or name == "Multitool" or name == "Shears" or name == "SkeletonKey") and not connectedTools[tool] then
                        connectedTools[tool] = true
                        tool.Activated:Connect(function()
                            local currentSettings = _G.CatHubSettings or CatHubSettings
                            if currentSettings and currentSettings.InfiniteItems then
                                pcall(function()
                                    local currentRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    if currentRoot and tool and tool.Parent == LocalPlayer.Character then
                                        -- Truque do Abyssal Hub: joga no workspace e puxa de volta instantaneamente no clique
                                        tool.Parent = workspace
                                        task.wait(0.08)
                                        if tool and tool.Parent == workspace then
                                            tool.Parent = LocalPlayer.Character
                                        end
                                    end
                                end)
                            end
                        end)
                    end
                end
            end)
        end
    end
end)

-- ==================== AUTO INTERACT CORRIGIDO ====================
task.spawn(function()
    while task.wait(0.2) do
        local settings = _G.CatHubSettings or CatHubSettings
        if settings and settings.AutoInteract then
            pcall(function()
                local char = LocalPlayer.Character
                local rootPart = char and char:FindFirstChild("HumanoidRootPart")
                local currentRooms = workspace:FindFirstChild("CurrentRooms")
                
                if rootPart and currentRooms then
                    local backpackCount = #LocalPlayer.Backpack:GetChildren()
                    local equippedTool = char:FindFirstChildOfClass("Tool")
                    local totalItems = backpackCount + (equippedTool and 1 or 0)
                    local inventoryFull = totalItems >= 4

                    local hasKey = false
                    for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
                        if item.Name:lower():find("key") then hasKey = true end
                    end
                    if equippedTool and equippedTool.Name:lower():find("key") then hasKey = true end

                    for _, room in ipairs(currentRooms:GetChildren()) do
                        -- 1. Abrir portas trancadas com chave
                        local door = room:FindFirstChild("Door")
                        if door and door:FindFirstChild("Lock") and hasKey then
                            local prompt = door:FindFirstChildOfClass("ProximityPrompt", true)
                            local part = door:FindFirstChildWhichIsA("BasePart")
                            if prompt and part and (rootPart.Position - part.Position).Magnitude < 12 then
                                fireproximityprompt(prompt)
                            end
                        end

                        -- 2. Interagir com itens e portas normais (Ignorando completamente armários/HidePrompt e a loja do Jeff)
                        local assets = room:FindFirstChild("Assets") or room
                        for _, obj in ipairs(assets:GetDescendants()) do
                            local isJeffShop = false
                            local p = obj.Parent
                            while p do
                                if p.Name:lower():find("shop") or p.Name:lower():find("jeff") then
                                    isJeffShop = true
                                    break
                                end
                                p = p.Parent
                            end

                            if not isJeffShop and obj:IsA("ProximityPrompt") then
                                -- Evita interagir com armários (HidePrompt)
                                if obj.Name ~= "HidePrompt" then
                                    local targetPart = obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")
                                    if targetPart and (rootPart.Position - targetPart.Position).Magnitude < 12 then
                                        local promptName = obj.ObjectText:lower()
                                        local isCoinOrKey = promptName:find("coin") or promptName:find("key") or obj.Name:lower():find("coin") or obj.Name:lower():find("key")
                                        
                                        if isCoinOrKey or not inventoryFull then
                                            fireproximityprompt(obj)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)


